{
  "name": "mythwar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mythwar: Ages of Legend - a three-lane, mythological take on Age of War",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node scripts/sim.ts",
    "smoke": "vite build && node scripts/smoke.ts",
    "verify": "tsc --noEmit && vitest run && vite build && node scripts/smoke.ts",
    "shoot": "vite build && node scripts/shoot.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
