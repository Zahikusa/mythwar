{
  "name": "mythwar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mythwar: Ages of Legend - a three-lane, mythological take on Age of War",
  "homepage": "https://zahikusa.github.io/mythwar/",
  "engines": {
    "node": ">=22.18.0 <23 || >=23.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zahikusa/mythwar.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "lan": "node scripts/nodecheck.mjs && tsc --noEmit && vite build && node server/main.ts",
    "serve": "node scripts/nodecheck.mjs && node server/main.ts",
    "package": "tsc --noEmit && node scripts/package.ts",
    "package:check": "npm run package && node scripts/packcheck.ts",
    "mpbot": "node scripts/mpbot.ts",
    "designcheck": "node scripts/designcheck.ts",
    "economy": "node scripts/economy.ts",
    "puzzlecheck": "node scripts/puzzlecheck.ts",
    "servercost": "node scripts/servercost.ts",
    "ogcard": "vite build && node scripts/ogcard.mjs",
    "docshot": "node scripts/docshot.ts",
    "perfcheck": "vite build && node scripts/perfcheck.ts",
    "enginecheck": "vite build && node scripts/enginecheck.ts",
    "mpengines": "vite build && node scripts/mpengines.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node scripts/sim.ts",
    "smoke": "vite build && node scripts/smoke.ts",
    "verify": "tsc --noEmit && vitest run && vite build && node scripts/smoke.ts && node scripts/mpsmoke.ts",
    "verify:all": "npm run verify && node scripts/enginecheck.ts && node scripts/designcheck.ts && node scripts/puzzlecheck.ts && node scripts/perfcheck.ts",
    "mpsmoke": "vite build && node scripts/mpsmoke.ts",
    "shoot": "vite build && node scripts/shoot.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  }
}
